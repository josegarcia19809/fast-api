---
import AdminShell from '../components/AdminShell.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Estadísticas | Fútbol IA">
  <AdminShell title="Estadísticas" active="estadisticas">
    <p class="field-hint">Gráficas calculadas con las respuestas reales de FastAPI. Los valores de mercado se expresan en millones de euros.</p>
    <div id="admin-error" class="status-line" data-error-target></div>
    <section class="leader-panel" aria-labelledby="leader-title">
      <div class="leader-copy">
        <span class="leader-kicker">LÍDER DE PLANTILLA</span>
        <h2 id="leader-title">Club con más jugadores</h2>
        <strong id="club-leader" aria-live="polite">Cargando…</strong>
        <p>Según la cantidad de jugadores registrados en FastAPI.</p>
      </div>
      <span class="leader-icon" aria-hidden="true">🏆</span>
    </section>
    <div class="stats-sections">
      <section class="panel"><h2>Cantidad de jugadores por club</h2><div id="stat-club-count" class="bar-list"><p class="loading">Cargando…</p></div></section>
      <section class="panel"><h2>Distribución por posición</h2><div id="stat-position" class="bar-list"><p class="loading">Cargando…</p></div></section>
      <section class="panel"><h2>Promedio de edad por club</h2><div id="stat-age" class="bar-list"><p class="loading">Cargando…</p></div></section>
      <section class="panel"><h2>Valor de mercado acumulado por club (€ M)</h2><div id="stat-market" class="bar-list"><p class="loading">Cargando…</p></div></section>
      <section class="panel"><h2>Jugadores por nacionalidad</h2><div id="stat-nationality" class="bar-list"><p class="loading">Cargando…</p></div></section>
      <section class="panel"><h2>Distribución por pie dominante</h2><div id="stat-foot" class="bar-list"><p class="loading">Cargando…</p></div></section>
    </div>
  </AdminShell>
</BaseLayout>

<style>
  .leader-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin: 16px 0;
    padding: 22px 24px;
    border: 1px solid #dce7f5;
    border-radius: 14px;
    background: linear-gradient(110deg, #fff, #f1f6fd);
  }

  .leader-copy h2 {
    margin: 5px 0 8px;
    color: #526076;
    font-size: 13px;
    font-weight: 650;
  }

  .leader-kicker {
    color: #7890b5;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1.3px;
  }

  .leader-copy strong {
    display: block;
    color: #1e3f70;
    font-size: clamp(20px, 3vw, 28px);
    line-height: 1.25;
  }

  .leader-copy p {
    margin: 7px 0 0;
    color: #8290a3;
    font-size: 11px;
  }

  .leader-icon {
    display: grid;
    width: 56px;
    height: 56px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 16px;
    background: #e4eefb;
    font-size: 27px;
  }

  @media (max-width: 460px) {
    .leader-panel { padding: 17px; }
    .leader-icon { width: 44px; height: 44px; font-size: 22px; }
  }
</style>
