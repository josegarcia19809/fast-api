<dialog id="record-dialog" class="record-dialog" aria-labelledby="record-dialog-title">
  <div class="dialog-heading">
    <h2 id="record-dialog-title">Detalle</h2>
    <button class="icon-button" type="button" data-close-dialog aria-label="Cerrar">×</button>
  </div>
  <div id="record-dialog-content" class="record-details"></div>
</dialog>

<style>
  .record-dialog {
    width: min(560px, calc(100vw - 28px));
    max-height: min(80vh, 720px);
    overflow: auto;
    border: 1px solid #e1e7ef;
    border-radius: 14px;
    padding: 20px;
    color: #1e293b;
    background: #fff;
    box-shadow: 0 24px 70px #10182844;
  }

  .record-dialog::backdrop { background: #11182788; }
  .dialog-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
  .dialog-heading h2 { margin: 0; font-size: 17px; }
  .record-details { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }
  .detail-item { min-width: 0; padding: 10px; border-radius: 8px; background: #f7f9fc; }
  .detail-label, .detail-value { display: block; overflow-wrap: anywhere; }
  .detail-label { color: #8490a3; font-size: 10px; }
  .detail-value { margin-top: 4px; color: #344054; font-size: 12px; font-weight: 650; }
  .detail-image { grid-column: 1 / -1; width: 112px; height: 112px; object-fit: cover; border-radius: 50%; }
  @media (max-width: 420px) { .record-details { grid-template-columns: 1fr; } }
</style>
