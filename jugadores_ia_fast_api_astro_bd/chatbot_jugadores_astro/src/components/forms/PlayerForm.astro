---
const { recordId = '' } = Astro.props;
const editing = Boolean(recordId);
---
<section class="panel form-panel">
  <p id="player-form-loading" class="loading" aria-live="polite" hidden>Cargando datos y clubes disponibles…</p>
  <p id="player-form-status" class="status-line" role="status" aria-live="polite"></p>
  <form id="player-form" class="admin-form" data-record-id={recordId} hidden={editing}>
    <div class="field"><label for="jugador-nombre">Nombre *</label><input id="jugador-nombre" name="nombre" maxlength="60" required /></div>
    <div class="field"><label for="jugador-apellido">Apellido *</label><input id="jugador-apellido" name="apellido" maxlength="60" required /></div>
    <div class="field"><label for="jugador-edad">Edad</label><input id="jugador-edad" name="edad" type="number" min="0" max="120" /></div>
    <div class="field"><label for="jugador-nacionalidad">Nacionalidad</label><input id="jugador-nacionalidad" name="nacionalidad" maxlength="60" /></div>
    <div class="field"><label for="jugador-posicion">Posición</label><input id="jugador-posicion" name="posicion" maxlength="30" /></div>
    <div class="field"><label for="jugador-numero">Número de camiseta</label><input id="jugador-numero" name="numero_camiseta" type="number" min="0" max="999" /></div>
    <div class="field"><label for="jugador-valor">Valor de mercado (millones de euros)</label><input id="jugador-valor" name="valor_mercado" type="number" min="0" step="0.01" /></div>
    <div class="field"><label for="jugador-altura">Altura (m)</label><input id="jugador-altura" name="altura" type="number" min="0.01" max="3" step="0.01" /></div>
    <div class="field"><label for="jugador-peso">Peso (kg)</label><input id="jugador-peso" name="peso" type="number" min="0.01" max="500" step="0.1" /></div>
    <div class="field"><label for="jugador-pie">Pie dominante</label><input id="jugador-pie" name="pie_dominante" maxlength="15" /></div>
    <div class="field"><label for="jugador-imagen">Imagen (URL o ruta)</label><input id="jugador-imagen" name="imagen" maxlength="500" /></div>
    <div class="field"><label for="jugador-club">Club *</label><select id="jugador-club" name="id_club" required><option value="">Cargando clubes…</option></select></div>
    <div class="form-actions">
      <a class="secondary-button" href="/jugadores">Cancelar</a>
      <button id="player-submit" class="primary-button" type="submit">{editing ? 'Guardar cambios' : 'Registrar jugador'}</button>
    </div>
  </form>
</section>
