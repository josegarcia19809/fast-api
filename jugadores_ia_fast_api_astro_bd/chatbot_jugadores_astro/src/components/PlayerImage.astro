---
interface Props {
  nombre?: string;
  imagen?: string | null;
  class?: string;
}

import { getPlayerImageUrl } from '../lib/api';

const { nombre = 'Jugador', imagen, class: className = '' } = Astro.props;
const url = getPlayerImageUrl(imagen);
const iniciales = nombre
  .trim()
  .split(/\s+/)
  .slice(0, 2)
  .map(parte => parte[0]?.toLocaleUpperCase() || '')
  .join('');
---

<figure class={`player-image ${className}`}>
  <img
    class="player-photo"
    src={url || '/images/player-placeholder.svg'}
    alt={`Fotografía de ${nombre}`}
    loading="lazy"
    decoding="async"
    data-player-photo
  />
  <span class="player-image-initials" aria-hidden="true">{iniciales}</span>
</figure>

<script>
  const fallback = '/images/player-placeholder.svg';
  document.addEventListener('error', (event) => {
    const image = event.target;
    if (!(image instanceof HTMLImageElement) || !image.matches('[data-player-photo]')) return;
    if (image.dataset.fallbackApplied === 'true') return;
    image.dataset.fallbackApplied = 'true';
    image.src = fallback;
  }, true);
</script>

<style>
  .player-image{position:relative;overflow:hidden;width:100%;aspect-ratio:1;border-radius:50%;background:#e8f0ff;margin:0}
  .player-photo{display:block;width:100%;height:100%;object-fit:cover}
  .player-image-initials{position:absolute;right:10px;bottom:10px;border-radius:8px;background:#111827bf;color:#fff;padding:4px 7px;font-size:11px;font-weight:700;letter-spacing:.04em}
</style>
